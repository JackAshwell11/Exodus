{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    ':disableMajorUpdates',
    ':semanticCommitsDisabled',
  ],
  dependencyDashboard: true,
  prHourlyLimit: 1,
  prConcurrentLimit: 3,
  conan: {
    enabled: true,
  },
  'github-actions': {
    enabled: true,
  },
  packageRules: [
    {
      matchCategories: [
        'python',
      ],
      enabled: true,
    },
    {
      matchManagers: [
        'pep621',
      ],
      matchFileNames: [
        'pyproject.toml',
      ],
    },
    {
      matchManagers: [
        'conan',
      ],
      matchUpdateTypes: [
        'patch',
        'minor',
      ],
      groupName: 'Conan dependency updates',
    },
    {
      matchManagers: [
        'pep621',
      ],
      matchUpdateTypes: [
        'patch',
        'minor',
      ],
      groupName: 'Python dependency updates',
    },
    {
      matchManagers: [
        'github-actions',
      ],
      matchUpdateTypes: [
        'patch',
        'minor',
      ],
      groupName: 'GitHub Actions updates',
    },
    {
      matchManagers: [
        'conan',
        'pep621',
        'github-actions',
      ],
      matchUpdateTypes: [
        'major',
      ],
      enabled: false,
    },
  ],
}
